BEGIN_PROLOG

standard_ECALMuonBDT:
{
 module_type:               ECALMuonBDT
 Verbosity:                 1
 BDTWeightDirectory:        "$GARSOFT_DIR/MVAData/weights" # path of BDT weight XML files
 BDTSummaryFileName:        "/pnfs/dune/persistent/users/fmlopez/GAr/MVAData/gar_bdt_summary_v00_01_00.root"   # rootfile with BDT training and calibration summary
 MaxMomentumECALOnly:       0.8 # point where we start training on MuID variables as well (in GeV/c)
 TMVAOutputMax:             1.0 # truncate the BDT output when
}

END_PROLOG